  "engines": {
    "node": ">=24.12.0",
    "npm": ">=11"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@reduxjs/toolkit": "2.13.0",
    "firebase": "13.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-redux": "9.3.0",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "oxlint": "1.88.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
